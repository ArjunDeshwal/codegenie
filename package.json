{
  "name": "codegenie",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev": "NODE_OPTIONS=--no-experimental-webstorage next dev --turbopack -p 3008",
